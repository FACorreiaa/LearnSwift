package layout

// Base is the HTML document every page is rendered into. It carries the head,
// the fonts, the stylesheet and the two scripts the whole app depends on, and
// nothing else — the visible shell lives in Public and App so a signed-out page
// and a signed-in page can differ without either one owning the document.
templ Base(title string) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			// Read by htmx as it initialises, so it must precede the script tag
			// rather than being set from JavaScript afterwards.
			//
			// htmx discards non-2xx responses by default, which throws away the
			// two failures this app most needs to render: 422 carries a form or
			// an exercise result with inline diagnostics, and 429 carries the
			// quota panel. Both are answers, not errors, and both are meant to
			// be swapped into the page.
			<meta
				name="htmx-config"
				content='{"responseHandling":[{"code":"422","swap":true},{"code":"429","swap":true},{"code":"[23]..","swap":true},{"code":"[45]..","swap":false,"error":true}]}'
			/>
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/assets/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<title>{ title }</title>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			@themeScript()
			<script src="/assets/js/vendor/htmx.min.js"></script>
			<script defer src="/assets/js/vendor/alpine.min.js"></script>
		</head>
		<body class="h-full bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

// Public is the shell for pages a signed-out visitor can reach.
templ Public(title string) {
	@Base(title) {
		<div class="flex h-full flex-col">
			@Navbar()
			<main class="flex-1">
				{ children... }
			</main>
		</div>
	}
}
