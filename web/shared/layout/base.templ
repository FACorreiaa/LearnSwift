package layout

// Base is the HTML document every page is rendered into. It carries the head,
// the fonts, the stylesheet and the two scripts the whole app depends on, and
// nothing else — the visible shell lives in Public and App so a signed-out page
// and a signed-in page can differ without either one owning the document.
templ Base(m Meta) {
	<!DOCTYPE html>
	<html lang="en" class="h-full">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<meta name="description" content={ m.description() }/>
			if c := m.canonical(); c != "" {
				<link rel="canonical" href={ c }/>
			}
			// Open Graph and the Twitter card. Without these every link to this
			// site — in Slack, on X, in a Discord channel, in a Reddit comment —
			// renders as a bare grey box, which is most of the first impression
			// anyone gets before they ever reach a page.
			<meta property="og:type" content="website"/>
			<meta property="og:site_name" content="Seshat"/>
			<meta property="og:title" content={ m.Title }/>
			<meta property="og:description" content={ m.description() }/>
			if c := m.canonical(); c != "" {
				<meta property="og:url" content={ c }/>
			}
			if img := m.imageURL(); img != "" {
				<meta property="og:image" content={ img }/>
				<meta name="twitter:image" content={ img }/>
			}
			<meta name="twitter:card" content="summary_large_image"/>
			<meta name="twitter:title" content={ m.Title }/>
			<meta name="twitter:description" content={ m.description() }/>
			// Read by htmx as it initialises, so it must precede the script tag
			// rather than being set from JavaScript afterwards.
			//
			// htmx 4 inverts the htmx 2 default and swaps every response except
			// 204 and 304, so this restores the old rule: a failure body is not
			// page content unless the element asking for it says so.
			//
			// The three failures this app does need to render — 422 for a form or
			// an exercise result with inline diagnostics, 429 for the quota and
			// busy panels, 503 for "the grader could not run, this is our fault,
			// not your code's" — are now opted back in per element with
			// hx-status:<code>, on the form that posts to the route that returns
			// them. htmx checks the exact status before the wildcard, so those
			// attributes win over the 4xx and 5xx entries here.
			//
			// 503 in particular: without it, a learner whose submission hits an
			// unavailable compiler sees absolutely nothing happen, which is a
			// worse outcome than the wrong verdict the panel exists to avoid.
			//
			// Unlike htmx 2's responseHandling there is no way to mark a status
			// as "swap, but not an error": htmx 4 fires htmx:response:error for
			// every response over 400 regardless. Nothing here listens for it,
			// so the distinction has no consumer to lose.
			<meta
				name="htmx-config"
				content='{"noSwap": [204, 304, "4xx", "5xx"]}'
			/>
			<link rel="preload" href="/assets/fonts/geist/geist-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<link rel="preload" href="/assets/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin="anonymous"/>
			<title>{ m.Title }</title>
			<link href="/assets/css/output.css" rel="stylesheet"/>
			@themeScript()
			<script src="/assets/js/vendor/htmx.min.js"></script>
			<script src="/assets/js/vendor/hx-alpine-compat.min.js"></script>
			<script defer src="/assets/js/vendor/alpine.min.js"></script>
		</head>
		<body class="h-full bg-background text-foreground">
			{ children... }
		</body>
	</html>
}

// Public is the shell for pages a signed-out visitor can reach.
templ Public(m Meta) {
	@Base(m) {
		<div class="flex h-full flex-col">
			@Navbar()
			<main class="flex-1">
				{ children... }
			</main>
		</div>
	}
}
