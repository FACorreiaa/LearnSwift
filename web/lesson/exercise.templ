package lesson

import (
	"fmt"
	"strconv"
	"time"

	"github.com/FACorreiaa/seshat/internal/validate"
	"github.com/FACorreiaa/seshat/web/shared/layout"
	"github.com/FACorreiaa/seshat/web/shared/utils"
)

// Result is the outcome of one submission, or the zero value before anything
// has been submitted.
type Result struct {
	Submitted bool
	Passed    bool
	Code      string

	Failures    []validate.Failure
	Diagnostics []validate.Diagnostic

	// CompileFailed means swiftc rejected the code. CompilerOutput carries its
	// diagnostics verbatim — Swift's compiler errors are better than anything
	// that would survive being reformatted, so they are shown as written.
	CompileFailed  bool
	CompilerOutput string

	// TimedOut means the program ran too long and was stopped. Almost always
	// an accidental infinite loop.
	TimedOut bool

	// Stdout is what the program printed, shown whether it passed or not: a
	// learner comparing their output to the expectation needs to see it.
	Stdout   string
	Stderr   string
	ExitCode uint32

	// Pending means every static check passed but the lesson also has
	// assertions that require running the code, which the compile pipeline
	// does not exist yet to do. The submission is therefore not known to be
	// correct, and must not be reported as such.
	Pending bool

	// Unavailable means the grader could not run at all. Shown differently from
	// a wrong answer, because telling someone their correct code is wrong
	// because a binary is missing is the worst outcome available here.
	Unavailable bool

	// Help is what this learner has earned the right to ask for, given how many
	// times they have already got it wrong.
	Help Help
}

// Help is the escape hatch for a learner who is stuck.
//
// Hint and Solution are empty until the moment they are revealed — the server
// sends the text only in response to the request that asks for it. That is the
// whole mechanism: a hint held back by a CSS class is a hint already given, and
// a learner who views source has not cheated so much as read what was sent.
type Help struct {
	Slug string

	HintAvailable     bool
	SolutionAvailable bool

	Hint     string
	Solution string
}

func (h Help) anything() bool {
	return h.HintAvailable || h.SolutionAvailable || h.Hint != "" || h.Solution != ""
}

templ exercise(v View) {
	<section id="exercise" class="mt-10 rounded-lg border">
		<h2 class="border-b px-4 py-3 font-semibold">Exercise</h2>
		<div class="p-4">
			if v.Lesson.Assertions.HasStatic() {
				@ExerciseForm(v)
				if !v.Lesson.Runtime.Executable() {
					// Said plainly rather than by omission. Checking still
					// works — reading the code is not the same as running it —
					// and a reader who has run code in another lesson will
					// otherwise assume this panel is broken.
					<p class="text-muted-foreground mt-3 text-sm">
						Your code is checked by reading it, not running it: SwiftUI is an
						Apple-only framework with no WebAssembly build.
					</p>
				}
			} else {
				<pre class="bg-muted overflow-x-auto rounded-md p-4 text-sm"><code>{ v.Lesson.Starter }</code></pre>
				<p class="text-muted-foreground mt-3 text-sm">
					This exercise has nothing that can be checked automatically yet.
					Compare your answer with the lesson.
				</p>
			}
		</div>
	</section>
}

// ExerciseForm is exported so the landing page can embed a working exercise.
//
// It is the same component, posting to the same route, graded by the same
// pipeline — not a mock. A landing page that demonstrates the product with a
// fake of the product is the one thing worse than not demonstrating it.
templ ExerciseForm(v View) {
	// /check answers with 422 for a submission found wanting, 429 for the quota
	// and busy panels, and 503 when the grader could not run. All three carry a
	// result panel meant for the page, so the hx-status attributes below opt
	// them back in against the blanket 4xx/5xx no-swap in the layout.
	<form
		hx-post={ "/lessons/" + v.Lesson.Slug + "/check" }
		hx-target="#exercise-result"
		hx-swap="outerHTML"
		hx-disable="find button"
		hx-status:422="swap:outerHTML"
		hx-status:429="swap:outerHTML"
		hx-status:503="swap:outerHTML"
	>
		@layout.CSRFInput()
		<label for="code" class="sr-only">Your Swift code</label>
		<textarea
			id="code"
			name="code"
			data-editor
			rows="14"
			spellcheck="false"
			autocapitalize="off"
			autocomplete="off"
			autocorrect="off"
			class="bg-muted focus-visible:ring-ring w-full resize-y rounded-md p-4 font-mono text-sm focus-visible:ring-2 focus-visible:outline-none"
		>{ starterFor(v) }</textarea>
		<div class="mt-3 flex flex-wrap items-center gap-3">
			<button
				type="submit"
				class="bg-primary text-primary-foreground hover:bg-primary/90 h-10 rounded-md px-4 text-sm font-medium disabled:opacity-60"
			>
				Check
			</button>
			<span class="text-muted-foreground text-sm htmx-indicator">Checking…</span>
			// Tab indents rather than moving focus, which a keyboard user has to
			// be told rather than left to discover by getting stuck.
			<span class="text-muted-foreground ml-auto text-xs">
				Tab indents · Esc then Tab leaves · ⌘/Ctrl+Enter checks
			</span>
		</div>
	</form>
	@ResultPanel(v.Result)
	@editorScript()
}

var editorScriptOnce = templ.NewOnceHandle()

templ editorScript() {
	@editorScriptOnce.Once() {
		if nonce := templ.GetNonce(ctx); nonce != "" {
			<script nonce={ nonce } defer src={ utils.ScriptURL("/assets/js/lesson/editor.js") }></script>
		} else {
			<script defer src={ utils.ScriptURL("/assets/js/lesson/editor.js") }></script>
		}
	}
}

// starterFor keeps whatever the learner last submitted, so a failed check does
// not throw away their work.
func starterFor(v View) string {
	if v.Result.Code != "" {
		return v.Result.Code
	}
	return v.Lesson.Starter
}

// ResultPanel is swapped in on its own by htmx, so checking an answer does not
// reload the lesson or lose the editor's scroll position.
templ ResultPanel(r Result) {
	<div id="exercise-result" class="mt-4">
		if r.Unavailable {
			<p class="border-muted-foreground/30 text-muted-foreground rounded-md border border-dashed px-3 py-2 text-sm">
				Checking is unavailable right now, so your answer could not be graded.
				This is a problem on our side, not with your code.
			</p>
		} else if r.Submitted && r.CompileFailed {
			<div class="space-y-2">
				<p class="text-muted-foreground text-sm">Your code did not compile.</p>
				<pre class="bg-destructive/10 text-destructive overflow-x-auto rounded-md p-3 font-mono text-xs" role="alert">{ r.CompilerOutput }</pre>
			</div>
		} else if r.Submitted && r.TimedOut {
			<p class="bg-destructive/10 text-destructive rounded-md px-3 py-2 text-sm" role="alert">
				Your code ran too long and was stopped. The usual cause is a loop with no
				way out.
			</p>
		} else if r.Submitted && r.Pending {
			<p class="border-muted-foreground/30 text-muted-foreground rounded-md border border-dashed px-3 py-2 text-sm" role="status">
				No problems found in your code. Checking the output it produces needs
				Swift to actually run, which is not wired up yet — so this is not a
				pass, only the absence of a failure.
			</p>
		} else if r.Submitted && r.Passed {
			<div class="space-y-2">
				<p class="rounded-md bg-emerald-500/10 px-3 py-2 text-sm text-emerald-700 dark:text-emerald-400" role="status">
					That's right.
				</p>
				@outputBlock(r)
			</div>
		} else if r.Submitted {
			<div class="bg-destructive/10 space-y-2 rounded-md px-3 py-2 text-sm" role="alert">
				for _, d := range r.Diagnostics {
					<p class="text-destructive">
						<span class="font-mono">{ fmt.Sprintf("line %d:%d", d.Line, d.Column) }</span>
						&nbsp;{ d.Message }
					</p>
				}
				for _, f := range r.Failures {
					<p class="text-destructive">{ f.Message }</p>
				}
			</div>
			@outputBlock(r)
			@HelpPanel(r.Help)
		}
	</div>
}

// QuotaPanel is what a learner sees when they have run out of checks.
//
// It swaps into the same slot as a result, so the editor and their code stay
// exactly where they were — being rate limited should read as "wait a minute",
// not as having lost the page. The copy says what happened, when it clears, and
// for a guest, the one thing that raises the ceiling.
templ QuotaPanel(retry time.Duration, guest bool) {
	<div id="exercise-result" class="mt-4">
		<div class="space-y-2 rounded-md border border-amber-500/40 bg-amber-500/10 px-3 py-2 text-sm" role="status">
			<p>
				That's a lot of checks in a short time. Try again in { humanDuration(retry) }.
			</p>
			if guest {
				// Every line of copy here starts with something other than `for`,
				// `if` or `switch` on purpose: templ reads those as control
				// keywords wherever a line begins, and silently fails to parse.
				<p class="text-muted-foreground">
					Checking runs a Swift compiler, so it is metered.
					<a href="/register" class="text-primary underline underline-offset-4">Create an account</a>
					to get a bigger allowance, and your progress gets saved along with it.
				</p>
			}
		</div>
	</div>
}

// BusyPanel reports that every compile slot was taken. Distinct from the quota
// panel on purpose: the learner did nothing wrong and has nothing to wait out
// but other people's submissions.
templ BusyPanel() {
	<div id="exercise-result" class="mt-4">
		<p class="border-muted-foreground/30 text-muted-foreground rounded-md border border-dashed px-3 py-2 text-sm" role="status">
			The compiler is busy right now, so your code has not been checked yet.
			Nothing is wrong with what you wrote — try again in a few seconds.
		</p>
	</div>
}

// humanDuration says "2 minutes", not "1m47.3s". A retry window is read by a
// person deciding whether to wait, and precision past the minute is noise.
func humanDuration(d time.Duration) string {
	if d < time.Minute {
		return "a moment"
	}
	if minutes := int(d.Round(time.Minute) / time.Minute); minutes > 1 {
		return strconv.Itoa(minutes) + " minutes"
	}
	return "a minute"
}

// HelpPanel is the way out for a learner who is stuck.
//
// It swaps itself, so asking for a hint neither reloads the lesson nor disturbs
// the code in the editor. Nothing renders until something has been earned: the
// first failure gets the diagnostics and no offer, because a learner who has
// been wrong once is not stuck, they are working.
templ HelpPanel(h Help) {
	<div id="exercise-help" class="mt-3">
		if h.anything() {
			<div class="space-y-3">
				if h.Hint != "" {
					<div class="rounded-md border border-dashed px-3 py-2 text-sm" role="status">
						<p class="text-muted-foreground mb-1 text-xs font-medium tracking-wide uppercase">Hint</p>
						<p>{ h.Hint }</p>
					</div>
				}
				if h.Solution != "" {
					<div class="space-y-1">
						<p class="text-muted-foreground text-xs font-medium tracking-wide uppercase">One way to write it</p>
						<pre class="bg-muted overflow-x-auto rounded-md p-3 font-mono text-xs"><code>{ h.Solution }</code></pre>
						<p class="text-muted-foreground text-xs">
							Read it, close it, and write it yourself. That second part is where
							the learning is.
						</p>
					</div>
				}
				<div class="flex flex-wrap gap-2">
					if h.HintAvailable && h.Hint == "" {
						<button
							type="button"
							hx-get={ "/lessons/" + h.Slug + "/hint" }
							hx-target="#exercise-help"
							hx-swap="outerHTML"
							class="hover:bg-muted h-8 rounded-md border px-3 text-sm font-medium"
						>
							Give me a hint
						</button>
					}
					if h.SolutionAvailable && h.Solution == "" {
						<form
							hx-post={ "/lessons/" + h.Slug + "/solution" }
							hx-target="#exercise-help"
							hx-swap="outerHTML"
						>
							@layout.CSRFInput()
							<button
								type="submit"
								class="text-muted-foreground hover:text-foreground h-8 rounded-md px-3 text-sm underline underline-offset-4"
							>
								Show me the answer
							</button>
						</form>
					}
				</div>
			</div>
		}
	</div>
}

// outputBlock shows what the program actually printed. It appears on success as
// well as failure: seeing the output is most of what makes running the code
// worth doing at all.
templ outputBlock(r Result) {
	if r.Stdout != "" || r.Stderr != "" {
		<div class="mt-2">
			<p class="text-muted-foreground mb-1 text-xs font-medium">Output</p>
			<pre class="bg-muted overflow-x-auto rounded-md p-3 font-mono text-xs">{ r.Stdout }{ r.Stderr }</pre>
		</div>
	}
}
