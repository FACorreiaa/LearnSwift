package auth

import "github.com/FACorreiaa/seshat/web/shared/layout"

// Form carries the values and messages needed to re-render a submitted form.
//
// Email is echoed back but Password never is: re-filling a password field from
// the server puts the secret in the response body and in any cache or log that
// touches it, to save one field of typing.
type Form struct {
	Email  string
	Errors map[string]string
}

func (f Form) Err(field string) string { return f.Errors[field] }

templ LoginPage(form Form) {
	@layout.Public(layout.Meta{
		Title:       "Sign in — Seshat",
		Description: "Sign in to save your progress through the Swift lessons.",
		Path:        "/login",
	}) {
		@shell("Sign in", "New here?", "/register", "Create an account") {
			@LoginForm(form)
		}
	}
}

// LoginForm is a separate component from the page because a failed submit is
// answered with a 422 carrying just this fragment, which htmx swaps in place.
// Re-sending the whole document would lose the visitor's scroll position and
// re-run every script on the page.
templ LoginForm(form Form) {
	<form id="auth-form" method="post" action="/login" hx-post="/login" hx-target="this" hx-swap="outerHTML" class="space-y-4">
		@layout.CSRFInput()
		@formError(form.Err("form"))
		@field("email", "Email", "email", form.Email, form.Err("email"), "username")
		@field("password", "Password", "password", "", form.Err("password"), "current-password")
		<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 h-10 w-full rounded-md text-sm font-medium">
			Sign in
		</button>
	</form>
}

templ RegisterPage(form Form) {
	@layout.Public(layout.Meta{
		Title:       "Create an account — Seshat",
		Description: "Create an account to save your progress through the Swift lessons.",
		Path:        "/register",
	}) {
		@shell("Create an account", "Already have one?", "/login", "Sign in") {
			@RegisterForm(form)
		}
	}
}

templ RegisterForm(form Form) {
	<form id="auth-form" method="post" action="/register" hx-post="/register" hx-target="this" hx-swap="outerHTML" class="space-y-4">
		@layout.CSRFInput()
		@formError(form.Err("form"))
		@field("email", "Email", "email", form.Email, form.Err("email"), "username")
		@field("password", "Password", "password", "", form.Err("password"), "new-password")
		<button type="submit" class="bg-primary text-primary-foreground hover:bg-primary/90 h-10 w-full rounded-md text-sm font-medium">
			Create account
		</button>
	</form>
}

templ shell(title, prompt, href, linkText string) {
	<div class="mx-auto flex max-w-sm flex-col gap-6 px-6 py-16">
		<div class="space-y-1 text-center">
			<h1 class="text-2xl font-semibold tracking-tight">{ title }</h1>
			<p class="text-muted-foreground text-sm">
				{ prompt }
				<a href={ templ.SafeURL(href) } class="text-primary underline underline-offset-4">{ linkText }</a>
			</p>
		</div>
		{ children... }
	</div>
}

templ formError(msg string) {
	if msg != "" {
		<p class="bg-destructive/10 text-destructive rounded-md px-3 py-2 text-sm" role="alert">{ msg }</p>
	}
}

templ field(name, label, kind, value, errMsg, autocomplete string) {
	<div class="space-y-1.5">
		<label for={ name } class="text-sm font-medium">{ label }</label>
		<input
			id={ name }
			name={ name }
			type={ kind }
			value={ value }
			autocomplete={ autocomplete }
			required
			if errMsg != "" {
				aria-invalid="true"
				aria-describedby={ name + "-error" }
			}
			class="border-input bg-background focus-visible:ring-ring h-10 w-full rounded-md border px-3 text-sm focus-visible:ring-2 focus-visible:outline-none"
		/>
		if errMsg != "" {
			<p id={ name + "-error" } class="text-destructive text-sm">{ errMsg }</p>
		}
	</div>
}
