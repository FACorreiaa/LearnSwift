GO_ENV=development
LISTEN_ADDR=:8090
BASE_URL=http://localhost:8090

# Matches docker-compose.yml. Port 5442 rather than 5432 so this stack can run
# alongside North's without either one having to be stopped first.
DATABASE_URL=postgres://seshat:seshat@localhost:5442/seshat?sslmode=disable

# Applied on boot in development. Must be false in-cluster, where the schema is
# applied once by a PreSync hook running `main migrate`.
AUTO_MIGRATE=true

LOG_LEVEL=info
ASSET_DIR=./web/assets

# Built by `task validate:build`. Grades exercises; see tools/swift-validate.
SWIFT_VALIDATE_BIN=./tools/swift-validate/.build/release/swift-validate

# Built by `task compiler:build`. Compiles and runs exercise submissions.
COMPILER_IMAGE=seshat-compiler:6.3.1
